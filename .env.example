# Copy this file to .env.local and fill in your values.
# Never commit .env.local — it is listed in .gitignore.

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=<32-character-random-string>

# Full URL of your deployed app (use http://localhost:3000 for local dev)
NEXTAUTH_URL=http://localhost:3000

# Google AI Studio API key — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=<your-gemini-api-key>

# AES-256 encryption key — generate with: openssl rand -base64 32
ENCRYPTION_KEY=<32-character-random-string>

# Demo data seed endpoint secret — choose any strong random string
# If not set, the /api/setup/demo endpoint is disabled.
DEMO_SECRET=<your-demo-secret>
